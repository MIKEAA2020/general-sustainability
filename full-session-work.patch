+            Jms[:DIM, :DIM] = J193
+            Jms[:DIM, DIM] = dF_dtau(w, tau)
+            Jms[DIM:2 * DIM, DIM + 1:] = J193
+            eps = 1e-7
+            for j in range(DIM + 1):
