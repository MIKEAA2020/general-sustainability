+        def ms_residual_jac(z, ell):
+            w = z[:DIM]
+            tau = z[DIM]
+            v = z[DIM + 1:]
+            res, J193 = residual_jac(w, tau)
+            M = np.r_[res, J193 @ v, ell @ v - 1.0]
+            if not want_jac:
