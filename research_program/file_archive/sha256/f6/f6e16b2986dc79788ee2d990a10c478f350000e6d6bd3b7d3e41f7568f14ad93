#!/usr/bin/env python3
"""Hash tracked research files and append file-level changes to a persistent log.

Usage:
  python research_program/track_file_changes.py snapshot --reason "..." --action ID
  python research_program/track_file_changes.py status

The first snapshot establishes a baseline. Later snapshots append create/modify/delete
records to file_change_log.csv and update file_manifest.csv.
"""
from pathlib import Path
from datetime import datetime, timezone
import argparse, csv, hashlib, shutil

ROOT=Path(__file__).resolve().parents[1]
RP=ROOT/'research_program'
MANIFEST=RP/'file_manifest.csv'
LOG=RP/'file_change_log.csv'
FIELDS=['path','sha256','size','category']
LOG_FIELDS=['timestamp_utc','event','path','old_sha256','new_sha256','old_size','new_size','reason','related_action']

EXCLUDE_NAMES={'file_manifest.csv','file_change_log.csv'}
EXCLUDE_DIRS={'.git','__pycache__','.cache','.venv','node_modules','file_archive'}
ARCHIVE=RP/'file_archive'/'sha256'
KEY_ROOT_FILES={
 'revised_sustainability_manuscript.md','revised_sustainability_manuscript.docx',
 'revised_manuscript_traceability.md','revised_manuscript_traceability.docx',
 'research_program_integration_protocol.md','overall_revision_plan.md',
 'parallel_audits_evaluation.md','joint_architectural_audit_evaluation.md',
 'general_theory_of_sustainability_manuscript.md','general_theory_of_sustainability_v0.1.md',
 'general_theory_of_sustainability_v0.2_comprehensive.md',
 'build_revised_sustainability_manuscript.py','build_revised_manuscript_traceability.py'
}

def digest(path):
 h=hashlib.sha256()
 with path.open('rb') as f:
  for chunk in iter(lambda:f.read(1024*1024),b''):h.update(chunk)
 return h.hexdigest()

def category(rel):
 parts=rel.parts
 if parts and parts[0]=='uploads': return 'immutable_source'
 if parts and parts[0]=='research_program': return 'research_record'
 if parts and parts[0]=='revised_articles': return 'corrected_article_source'
 if rel.name.endswith('.docx'): return 'rendered_manuscript'
 if 'manuscript' in rel.name: return 'manuscript_source'
 return 'project_file'

def tracked_files():
 files=[]
 for base in [ROOT/'research_program',ROOT/'uploads',ROOT/'revised_articles']:
  if not base.exists():continue
  for p in base.rglob('*'):
   if not p.is_file() or p.name in EXCLUDE_NAMES or any(x in EXCLUDE_DIRS for x in p.parts):continue
   files.append(p)
 for name in KEY_ROOT_FILES:
  p=ROOT/name
  if p.is_file():files.append(p)
 return sorted(set(files))

def scan():
 out={}
 for p in tracked_files():
  rel=p.relative_to(ROOT)
  sha=digest(p)
  out[str(rel)]={'path':str(rel),'sha256':sha,'size':str(p.stat().st_size),'category':category(rel)}
 return out

def archive_current(rows):
 """Store one content-addressed copy of every current tracked file."""
 for rel,meta in rows.items():
  src=ROOT/rel
  dst=ARCHIVE/meta['sha256'][:2]/meta['sha256']
  if not dst.exists():
   dst.parent.mkdir(parents=True,exist_ok=True)
   shutil.copyfile(src,dst)

def load_manifest():
 if not MANIFEST.exists():return {}
 with MANIFEST.open(encoding='utf-8',newline='') as f:return {r['path']:r for r in csv.DictReader(f)}

def write_manifest(rows):
 with MANIFEST.open('w',encoding='utf-8',newline='') as f:
  w=csv.DictWriter(f,fieldnames=FIELDS);w.writeheader();w.writerows(rows[k] for k in sorted(rows))

def append_log(events,reason,action):
 exists=LOG.exists()
 with LOG.open('a',encoding='utf-8',newline='') as f:
  w=csv.DictWriter(f,fieldnames=LOG_FIELDS)
  if not exists:w.writeheader()
  stamp=datetime.now(timezone.utc).isoformat()
  for e in events:
   e.update(timestamp_utc=stamp,reason=reason,related_action=action)
   w.writerow(e)

def changes(old,new,baseline=False):
 ev=[]
 if baseline:
  for k,n in new.items():ev.append(dict(event='baseline',path=k,old_sha256='',new_sha256=n['sha256'],old_size='',new_size=n['size']))
  return ev
 for k in sorted(set(old)|set(new)):
  o=old.get(k);n=new.get(k)
  if o is None:ev.append(dict(event='created',path=k,old_sha256='',new_sha256=n['sha256'],old_size='',new_size=n['size']))
  elif n is None:ev.append(dict(event='deleted',path=k,old_sha256=o['sha256'],new_sha256='',old_size=o['size'],new_size=''))
  elif o['sha256']!=n['sha256']:ev.append(dict(event='modified',path=k,old_sha256=o['sha256'],new_sha256=n['sha256'],old_size=o['size'],new_size=n['size']))
 return ev

def main():
 ap=argparse.ArgumentParser();sub=ap.add_subparsers(dest='cmd',required=True)
 sp=sub.add_parser('snapshot');sp.add_argument('--reason',required=True);sp.add_argument('--action',default='')
 sub.add_parser('status')
 args=ap.parse_args();old=load_manifest();new=scan();ev=changes(old,new,baseline=not bool(old))
 if args.cmd=='status':
  for e in ev:print(f"{e['event']:9} {e['path']}")
  print(f"\n{len(ev)} unlogged change(s)");return
 archive_current(new)
 append_log(ev,args.reason,args.action);write_manifest(new)
 print(f"Logged {len(ev)} event(s); manifest now tracks {len(new)} file(s); content archive updated")

if __name__=='__main__':main()
