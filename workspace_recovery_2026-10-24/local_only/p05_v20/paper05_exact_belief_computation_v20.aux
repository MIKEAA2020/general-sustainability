\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Left: exact slack trajectories of the ten cells of a boundary ten-set ($V=\genfrac  {}{}{}1{5}{2}$) under the certified winning word from $L^{\ast }=3$ (prefix of five actions, period four); two cells return to the floor every fourth step, as Proposition\nobreakspace  {}\ref  {prop:pinned} requires. Right: the pinned cell of the second boundary ten-set of the sorted record simulated in \texttt  {float64}, shown as the deviation from the exact stock in units of $10^{-16}$ for the two codings of the same drift; dotted lines mark the steps at which the exact slack is $0$, where the floor test is decided by the sign of the rounding error. The coding $(2k-5)/10$ declares the stock below the floor at step $3$; in \texttt  {float32} the error at step $3$ is $-1.2\cdot 10^{-7}$ under either coding.\relax }}{16}{figure.caption.19}\protected@file@percent }
\newlabel{fig:knife}{{3}{16}{Left: exact slack trajectories of the ten cells of a boundary ten-set ($V=\tfr 52$) under the certified winning word from $\Lstar =3$ (prefix of five actions, period four); two cells return to the floor every fourth step, as Proposition~\ref {prop:pinned} requires. Right: the pinned cell of the second boundary ten-set of the sorted record simulated in \texttt {float64}, shown as the deviation from the exact stock in units of $10^{-16}$ for the two codings of the same drift; dotted lines mark the steps at which the exact slack is $0$, where the floor test is decided by the sign of the rounding error. The coding $(2k-5)/10$ declares the stock below the floor at step $3$; in \texttt {float32} the error at step $3$ is $-1.2\cdot 10^{-7}$ under either coding.\relax }{figure.caption.19}{}}
