\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Kernel census. For each class: viable pairs among the $36$ pairs of safe states and viable beliefs among the $255$ nonempty subsets of the eight viable states, under the shared ledger ($\ell $), the private register ($\pi $) and the optimistic ledger ($\ell ^{+}$); the last column counts the inclusion-maximal viable beliefs under the shared ledger by size (count$\times $size). The free-protocol classes do not involve a register. The blind row is the one-cell observation; the decentralised row is Section\nobreakspace  {}\ref  {sec:dec}.\relax }}{8}{table.caption.5}\protected@file@percent }
\newlabel{tab:kernels}{{1}{8}{Kernel census. For each class: viable pairs among the $36$ pairs of safe states and viable beliefs among the $255$ nonempty subsets of the eight viable states, under the shared ledger ($\led $), the private register ($\priv $) and the optimistic ledger ($\opt $); the last column counts the inclusion-maximal viable beliefs under the shared ledger by size (count$\times $size). The free-protocol classes do not involve a register. The blind row is the one-cell observation; the decentralised row is Section~\ref {sec:dec}.\relax }{table.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Inclusions between the kernels on the $255$ beliefs. Arrows are inclusions predicted by Theorem\nobreakspace  {}\ref  {thm:mono} (observation axis horizontal, protocol axis vertical); every arrow is strict, the aggregate and codex kernels are incomparable, and the blind kernel coincides with the shared-ledger institutional kernel. The private-register conventions (right) are incomparable with the shared ledger at full observation: $\mathsf  {13|31}$ is ledger-viable and private-dead, $\mathsf  {12|21}$ the reverse.\relax }}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:lattice}{{2}{8}{Inclusions between the kernels on the $255$ beliefs. Arrows are inclusions predicted by Theorem~\ref {thm:mono} (observation axis horizontal, protocol axis vertical); every arrow is strict, the aggregate and codex kernels are incomparable, and the blind kernel coincides with the shared-ledger institutional kernel. The private-register conventions (right) are incomparable with the shared ledger at full observation: $\st {13|31}$ is ledger-viable and private-dead, $\st {12|21}$ the reverse.\relax }{figure.caption.6}{}}
