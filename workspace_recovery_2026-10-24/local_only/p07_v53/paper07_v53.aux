\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Baseline SSB periodicity screen. Left: Benjamini--Hochberg q-values for 84 stock-by-band tests; the dashed line denotes 0.05. Right: per-stock band power relative to the fitted AR(1) 95\% null threshold (A: 2.5--5 years; B: 5--9 years). A high ratio is a diagnostic exceedance measure, not a causal governance signal.}}{8}{figure.caption.9}\protected@file@percent }
\newlabel{fig:screen}{{4}{8}{Baseline SSB periodicity screen. Left: Benjamini--Hochberg q-values for 84 stock-by-band tests; the dashed line denotes 0.05. Right: per-stock band power relative to the fitted AR(1) 95\% null threshold (A: 2.5--5 years; B: 5--9 years). A high ratio is a diagnostic exceedance measure, not a causal governance signal}{figure.caption.9}{}}
