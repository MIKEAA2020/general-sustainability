\@writefile{lot}{\contentsline {table}{\numberline {S13}{\ignorespaces Matched technology-wave/no-wave debt maxima. Entries are $D_{max}$ in gha\,yr, with the time of the maximum in years in parentheses; the ratio is wave/no-wave. ``All'' is the maximum over $0\le t\le 250$\,yr; $t\ge 40$ is the post-midpoint maximum. The $P_0=1.0$ all-time peaks both occur after the midpoint.}}{18}{table.13}\protected@file@percent }
\newlabel{tab:si_wave_debt}{{S13}{18}{Matched technology-wave/no-wave debt maxima. Entries are $D_{max}$ in gha\,yr, with the time of the maximum in years in parentheses; the ratio is wave/no-wave. ``All'' is the maximum over $0\le t\le 250$\,yr; $t\ge 40$ is the post-midpoint maximum. The $P_0=1.0$ all-time peaks both occur after the midpoint}{table.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces Matched endogenous-demand technology-wave/no-wave simulation at $P_0=1.0$\,cap. Parameters and initial conditions are listed in SI\nobreakspace  {}\S  S8; only $T_b$ is switched on or off. (a) The active logistic increment $T_b(t)$, with the dotted line at its midpoint $t_{wave}=40$\,yr; (b) annual account values $B$ and $E$ (gha); (c) population $P$ (cap); (d) leaky model debt $D$ (gha\,yr). Markers denote all-time maxima, which occur at $86.15$\,yr without the wave and $115.60$\,yr with it; peak debt is $0.008126$ versus $0.020205$\,gha\,yr. The plotted wave begins with its small logistic tail at $t=0$ and approaches $\Delta b=1.0$\,gha\,ha$^{-1}$; the dotted line marks the midpoint, not an end date.}}{19}{figure.5}\protected@file@percent }
\newlabel{fig:si_wave_debt}{{S5}{19}{Matched endogenous-demand technology-wave/no-wave simulation at $P_0=1.0$\,cap. Parameters and initial conditions are listed in SI~\S S8; only $T_b$ is switched on or off. (a) The active logistic increment $T_b(t)$, with the dotted line at its midpoint $t_{wave}=40$\,yr; (b) annual account values $B$ and $E$ (gha); (c) population $P$ (cap); (d) leaky model debt $D$ (gha\,yr). Markers denote all-time maxima, which occur at $86.15$\,yr without the wave and $115.60$\,yr with it; peak debt is $0.008126$ versus $0.020205$\,gha\,yr. The plotted wave begins with its small logistic tail at $t=0$ and approaches $\Delta b=1.0$\,gha\,ha$^{-1}$; the dotted line marks the midpoint, not an end date}{figure.5}{}}
