\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces Full delayed one-stock comparator with a logistic technology increment. Parameters: $A_0=1.0$ stock unit, $P_0=0.45$\,cap, $b_0=0.5$, $b_G=0.6$, $\rho =0.08$\,yr$^{-1}$, $A_{\qopname  \relax m{max}}=1.2$ stock units, $e=0.55$\,gha\,cap$^{-1}$, $r=0.02$\,yr$^{-1}$, $\eta =0.03$\,yr$^{-1}$, $\alpha =0.2$\,gha$^{-1}$\,yr$^{-1}$, $\tau _g=15$\,yr, $\tau _p=25$\,yr, $A_{\mathrm  {ext}}=0.02$ stock units, $K_{\qopname  \relax m{min}}=10^{-4}$\,cap, $\Delta b=0.5$\,gha per stock unit, $\kappa =0.04$\,yr$^{-1}$, and $t_w=120$\,yr; $\sigma =1$, $\omega _{Tb}=1$, and $D_0=0$. The positive-part operator is exact. $B$ and $E$ are in gha, $A$ in comparator-specific stock units, $P$ in cap, and $D$ in gha\,yr. The trajectory reaches the imposed lower bound near $721$\,yr and subsequently recovers as modeled demand falls; the bound is not absorbing. This is a conditional model illustration, not an observation or a two-land result.}}{16}{figure.1}\protected@file@percent }
\newlabel{fig:si_onestock_full}{{S1}{16}{Full delayed one-stock comparator with a logistic technology increment. Parameters: $A_0=1.0$ stock unit, $P_0=0.45$\,cap, $b_0=0.5$, $b_G=0.6$, $\rho =0.08$\,yr$^{-1}$, $A_{\max }=1.2$ stock units, $e=0.55$\,gha\,cap$^{-1}$, $r=0.02$\,yr$^{-1}$, $\eta =0.03$\,yr$^{-1}$, $\alpha =0.2$\,gha$^{-1}$\,yr$^{-1}$, $\tau _g=15$\,yr, $\tau _p=25$\,yr, $A_{\mathrm {ext}}=0.02$ stock units, $K_{\min }=10^{-4}$\,cap, $\Delta b=0.5$\,gha per stock unit, $\kappa =0.04$\,yr$^{-1}$, and $t_w=120$\,yr; $\sigma =1$, $\omega _{Tb}=1$, and $D_0=0$. The positive-part operator is exact. $B$ and $E$ are in gha, $A$ in comparator-specific stock units, $P$ in cap, and $D$ in gha\,yr. The trajectory reaches the imposed lower bound near $721$\,yr and subsequently recovers as modeled demand falls; the bound is not absorbing. This is a conditional model illustration, not an observation or a two-land result}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces One-stock masking example with fixed demand and no delays. Parameters: $A_0=1.0$ stock unit, $E=0.60$\,gha, $b_0=0.5$, $b_G=0.8$, $\rho =0.05$\,yr$^{-1}$, $A_{\qopname  \relax m{max}}=1.2$ stock units, $\eta =0.05$\,yr$^{-1}$, $\alpha =0.03$\,gha$^{-1}$\,yr$^{-1}$, $\Delta b=1.5$\,gha per stock unit, $\kappa =0.2$\,yr$^{-1}$, and $t_w=15$\,yr; $\sigma =1$, $\omega _{Tb}=1$, and $D_0=0$. Under the exact positive-part operator, the interval with $\dot  B>0$ and $\dot  A<0$ lasts about $3.0$\,yr; over it, $A$ falls from about $0.937$ to $0.867$ stock units while $B$ rises from about $0.575$ to $0.600$\,gha. Panel (b) shows the interval width across initial shortfalls $[E(0)-b(0)A_0]_+$ for this parameterization. These are conditional comparator outputs.}}{16}{figure.2}\protected@file@percent }
\newlabel{fig:si_onestock_mask}{{S2}{16}{One-stock masking example with fixed demand and no delays. Parameters: $A_0=1.0$ stock unit, $E=0.60$\,gha, $b_0=0.5$, $b_G=0.8$, $\rho =0.05$\,yr$^{-1}$, $A_{\max }=1.2$ stock units, $\eta =0.05$\,yr$^{-1}$, $\alpha =0.03$\,gha$^{-1}$\,yr$^{-1}$, $\Delta b=1.5$\,gha per stock unit, $\kappa =0.2$\,yr$^{-1}$, and $t_w=15$\,yr; $\sigma =1$, $\omega _{Tb}=1$, and $D_0=0$. Under the exact positive-part operator, the interval with $\dot B>0$ and $\dot A<0$ lasts about $3.0$\,yr; over it, $A$ falls from about $0.937$ to $0.867$ stock units while $B$ rises from about $0.575$ to $0.600$\,gha. Panel (b) shows the interval width across initial shortfalls $[E(0)-b(0)A_0]_+$ for this parameterization. These are conditional comparator outputs}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces Controlled regeneration-delay examples in the debt-free one-stock subsystem. Both runs use $A_0=1.0$ stock unit, $P_0=0.1$\,cap, $b=0.5$, $b_G=0.8$, $\rho =0.05$\,yr$^{-1}$, $A_{\qopname  \relax m{max}}=1.2$ stock units, $e=0.55$\,gha\,cap$^{-1}$, $r=0.02$\,yr$^{-1}$, $\tau _p=25$\,yr, $A_{\mathrm  {ext}}=0.02$ stock units, $K_{\qopname  \relax m{min}}=10^{-6}$\,cap, and $\sigma =1$; only $\tau _g$ differs ($10$ versus $30$\,yr). $B$ is in gha, $P$ in cap, and $A$ in comparator-specific stock units. The selected trajectories do not determine a general critical delay.}}{17}{figure.3}\protected@file@percent }
\newlabel{fig:si_onestock_delay}{{S3}{17}{Controlled regeneration-delay examples in the debt-free one-stock subsystem. Both runs use $A_0=1.0$ stock unit, $P_0=0.1$\,cap, $b=0.5$, $b_G=0.8$, $\rho =0.05$\,yr$^{-1}$, $A_{\max }=1.2$ stock units, $e=0.55$\,gha\,cap$^{-1}$, $r=0.02$\,yr$^{-1}$, $\tau _p=25$\,yr, $A_{\mathrm {ext}}=0.02$ stock units, $K_{\min }=10^{-6}$\,cap, and $\sigma =1$; only $\tau _g$ differs ($10$ versus $30$\,yr). $B$ is in gha, $P$ in cap, and $A$ in comparator-specific stock units. The selected trajectories do not determine a general critical delay}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces Finite-grid initial-condition classification in the debt-free one-stock subsystem. The debt-free runs use the same parameter set as Fig.\nobreakspace  {}\ref  {fig:si_onestock_delay}, with $K_{\qopname  \relax m{min}}=10^{-6}$\,cap and $\tau _p=25$\,yr; $\tau _g=0$\,yr in the left panel and $30$\,yr in the right; the imposed lower bound is $A_{\mathrm  {ext}}=0.02$ stock units. The grid is $A_0=0.10,0.20,\ldots  ,1.30$ stock units and $P_0=0.05,0.15,\ldots  ,1.55$\,cap; trajectories are integrated to $1200$\,yr with $\Delta t=0.5$\,yr. Green denotes a high endpoint $A(1200)\ge 0.95A_{\qopname  \relax m{max}}$, red a low endpoint $A(1200)\le 0.05$ stock units, and gray an intermediate endpoint. These display-grid classifications are not probabilities or continuous-basin measures.}}{17}{figure.4}\protected@file@percent }
\newlabel{fig:si_onestock_basin}{{S4}{17}{Finite-grid initial-condition classification in the debt-free one-stock subsystem. The debt-free runs use the same parameter set as Fig.~\ref {fig:si_onestock_delay}, with $K_{\min }=10^{-6}$\,cap and $\tau _p=25$\,yr; $\tau _g=0$\,yr in the left panel and $30$\,yr in the right; the imposed lower bound is $A_{\mathrm {ext}}=0.02$ stock units. The grid is $A_0=0.10,0.20,\ldots ,1.30$ stock units and $P_0=0.05,0.15,\ldots ,1.55$\,cap; trajectories are integrated to $1200$\,yr with $\Delta t=0.5$\,yr. Green denotes a high endpoint $A(1200)\ge 0.95A_{\max }$, red a low endpoint $A(1200)\le 0.05$ stock units, and gray an intermediate endpoint. These display-grid classifications are not probabilities or continuous-basin measures}{figure.4}{}}
