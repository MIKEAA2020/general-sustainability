\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Model results at the baseline parameter set (Table\nobreakspace  {}\ref  {tab:params}). Account amounts $B$ and $E$ are in gha; land areas are in ha; population is in cap. (a) Frozen demand $E=0.825$\,gha, restoration off, $A_{f0}=0.6$\,ha, $A_{c0}=1.5$\,ha, and $q_0=0.9$. $B$ rises from $0.594$ to $0.825$\,gha as $A_c$ falls from $1.500$ to $0.808$\,ha and $A_f$ rises from $0.600$ to $0.923$\,ha. Shading marks the interval with $\dot  B>0$ and $\dot  A_c<0$ (about $149$\,yr; only the first $60$\,yr are shown; within $25$\,yr, $98\%$ of the rise in $B$ and $85\%$ of the fall in $A_c$ occur). (b) Fixed-demand balance relation $B_{eq}(A_c)$ and its calculated areas $A_c^*(E)=1.110$, $0.626$, $0.385$, $0.143$, and $0.070$\,ha at $E=0.70$, $0.90$, $1.00$, $1.10$, and $1.13$\,gha. The curve meets the minimum $A_c=0.05$\,ha at $E_{\mathrm  {ceil}}\approx 1.138$\,gha; above this demand, no balance point is admissible. (c) Endogenous-demand runs with $\tau _g=20$\,yr, $\tau _p=25$\,yr, and $\chi _r=0.10$\,gha$^{-1}$\,yr$^{-1}$. For each starting area $A_{c0}$, the minimum area reached varies continuously and monotonically with initial population $P_0$ (initial demand $E_0=eP_0$). The floor is approached asymptotically; triangles mark the proximity values in Table\nobreakspace  {}\ref  {tab:model}, defined by an approach to within $10^{-6}$\,ha. No discontinuity is observed.}}{13}{figure.1}\protected@file@percent }
\newlabel{fig:model}{{1}{13}{Model results at the baseline parameter set (Table~\ref {tab:params}). Account amounts $B$ and $E$ are in gha; land areas are in ha; population is in cap. (a) Frozen demand $E=0.825$\,gha, restoration off, $A_{f0}=0.6$\,ha, $A_{c0}=1.5$\,ha, and $q_0=0.9$. $B$ rises from $0.594$ to $0.825$\,gha as $A_c$ falls from $1.500$ to $0.808$\,ha and $A_f$ rises from $0.600$ to $0.923$\,ha. Shading marks the interval with $\dot B>0$ and $\dot A_c<0$ (about $149$\,yr; only the first $60$\,yr are shown; within $25$\,yr, $98\%$ of the rise in $B$ and $85\%$ of the fall in $A_c$ occur). (b) Fixed-demand balance relation $B_{eq}(A_c)$ and its calculated areas $A_c^*(E)=1.110$, $0.626$, $0.385$, $0.143$, and $0.070$\,ha at $E=0.70$, $0.90$, $1.00$, $1.10$, and $1.13$\,gha. The curve meets the minimum $A_c=0.05$\,ha at $\Eceil \approx 1.138$\,gha; above this demand, no balance point is admissible. (c) Endogenous-demand runs with $\tau _g=20$\,yr, $\tau _p=25$\,yr, and $\chi _r=0.10$\,gha$^{-1}$\,yr$^{-1}$. For each starting area $A_{c0}$, the minimum area reached varies continuously and monotonically with initial population $P_0$ (initial demand $E_0=eP_0$). The floor is approached asymptotically; triangles mark the proximity values in Table~\ref {tab:model}, defined by an approach to within $10^{-6}$\,ha. No discontinuity is observed}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Model results at the baseline parameter set. (a) Composition difference at $q^*=q_{\qopname  \relax m{max}}/2$ ($\Upsilon _c(q^*)=0.066$\,gha\,ha$^{-1}$), eigenvalues of the deficit-side matrix $J$ of \textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:J}\unskip \@@italiccorr )}} and the demand ceiling, for a sweep of the fast-land yield $b_f$ (all other parameters at baseline). (b) Initial population $P_0$ (cap; $E_0=eP_0$ in gha, with $e=0.55$\,gha\,cap$^{-1}$) at which the minimum capital land reached during an endogenous-demand run ($A_{f0}=0.6$\,ha, dimensionless $q_0=0.9$, $\tau _g=20$\,yr, $\tau _p=25$\,yr) comes within the stated distance of the typed floor $A_c^{\qopname  \relax m{min}}=0.05$; the first two columns are read from a $P_0$ grid of step $0.1$ ($\Delta t=0.1$\,yr, $T=400$\,yr), the last is a bisection using the $10^{-6}$\,ha floor-proximity criterion ($\Delta t=0.05$\,yr, $T=1000$\,yr). Drawdown depth is continuous in $P_0$ (Fig.\nobreakspace  {}\ref  {fig:model}c); the thresholds are a band, not a single value.}}{16}{table.2}\protected@file@percent }
\newlabel{tab:model}{{2}{16}{Model results at the baseline parameter set. (a) Composition difference at $q^*=q_{\max }/2$ ($\Ups (q^*)=0.066$\,gha\,ha$^{-1}$), eigenvalues of the deficit-side matrix $J$ of \eqref {eq:J} and the demand ceiling, for a sweep of the fast-land yield $b_f$ (all other parameters at baseline). (b) Initial population $P_0$ (cap; $E_0=eP_0$ in gha, with $e=0.55$\,gha\,cap$^{-1}$) at which the minimum capital land reached during an endogenous-demand run ($A_{f0}=0.6$\,ha, dimensionless $q_0=0.9$, $\tau _g=20$\,yr, $\tau _p=25$\,yr) comes within the stated distance of the typed floor $\Acmin =0.05$; the first two columns are read from a $P_0$ grid of step $0.1$ ($\Delta t=0.1$\,yr, $T=400$\,yr), the last is a bisection using the $10^{-6}$\,ha floor-proximity criterion ($\Delta t=0.05$\,yr, $T=1000$\,yr). Drawdown depth is continuous in $P_0$ (Fig.~\ref {fig:model}c); the thresholds are a band, not a single value}{table.2}{}}
