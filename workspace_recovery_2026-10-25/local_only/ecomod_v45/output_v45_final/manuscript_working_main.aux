\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Model results at the baseline registry. (a) Composition diagnostic at $q^*=q_{\max }/2$ ($\Upsilon _c(q^*)=0.066$\,gha\,ha$^{-1}$), eigenvalues of the deficit-side matrix $J$ of \eqref  {eq:J} and the demand ceiling, for a sweep of the fast-land yield $b_f$ (all other parameters at baseline). (b) Initial population $P_0$ (cap; initial footprint $E_0=0.55P_0$ in gha) at which the minimum capital land reached during an endogenous-demand run ($A_{f0}=0.6$\,ha, dimensionless $q_0=0.9$, $\tau _g=20$\,yr, $\tau _p=25$\,yr) comes within the stated distance of the typed floor $A_c^{\min }=0.05$; the first two columns are read from a $P_0$ grid of step $0.1$ ($\Delta t=0.1$\,yr, $T=400$\,yr), the last is a bisection using the $10^{-6}$\,ha floor-proximity criterion ($\Delta t=0.05$\,yr, $T=1000$\,yr). Drawdown depth is continuous in $P_0$ (Fig.~\ref {fig:model}c); the thresholds are a band, not a single value.}}{18}{table.2}\protected@file@percent }
\newlabel{tab:model}{{2}{18}{Model results at the baseline registry. (a) Composition diagnostic at $q^*=q_{\max }/2$ ($\Ups (q^*)=0.066$\,gha\,ha$^{-1}$), eigenvalues of the deficit-side matrix $J$ of \eqref {eq:J} and the demand ceiling, for a sweep of the fast-land yield $b_f$ (all other parameters at baseline). (b) Initial population $P_0$ (cap; initial footprint $E_0=0.55P_0$ in gha) at which the minimum capital land reached during an endogenous-demand run ($A_{f0}=0.6$\,ha, dimensionless $q_0=0.9$, $\tau _g=20$\,yr, $\tau _p=25$\,yr) comes within the stated distance of the typed floor $\Acmin =0.05$; the first two columns are read from a $P_0$ grid of step $0.1$ ($\Delta t=0.1$\,yr, $T=400$\,yr), the last is a bisection using the $10^{-6}$\,ha floor-proximity criterion ($\Delta t=0.05$\,yr, $T=1000$\,yr). Drawdown depth is continuous in $P_0$ (Fig.~\ref {fig:model}c); the thresholds are a band, not a single value}{table.2}{}}
