\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Aggregate and per-capita movements in NFA Edition 2026 (world, 1961--2023; complete observations). $B$ is total biocapacity, $E_{\mathrm  {prod}}$ is the workbook's Global Ecological Footprint of Production, and $P$ is the single UN PopStat population series; per-capita values are recomputed from totals. (a) Indices (1961 $=1$) of $B$, $B/P$, and $E_{\mathrm  {prod}}/P$. (b) $E_{\mathrm  {prod}}/B$, first above one in 1973. (c) Exact log identity $\Delta \ln B=\Delta \ln P+\Delta \ln (B/P)$. Account values are in gha; plotted indices, ratios, and log changes are dimensionless. The 2024--2025 estimated rows are excluded.}}{21}{figure.2}\protected@file@percent }
\newlabel{fig:aggregation}{{2}{21}{Aggregate and per-capita movements in NFA Edition 2026 (world, 1961--2023; complete observations). $B$ is total biocapacity, $E_{\mathrm {prod}}$ is the workbook's Global Ecological Footprint of Production, and $P$ is the single UN PopStat population series; per-capita values are recomputed from totals. (a) Indices (1961 $=1$) of $B$, $B/P$, and $E_{\mathrm {prod}}/P$. (b) $E_{\mathrm {prod}}/B$, first above one in 1973. (c) Exact log identity $\Delta \ln B=\Delta \ln P+\Delta \ln (B/P)$. Account values are in gha; plotted indices, ratios, and log changes are dimensionless. The 2024--2025 estimated rows are excluded}{figure.2}{}}
